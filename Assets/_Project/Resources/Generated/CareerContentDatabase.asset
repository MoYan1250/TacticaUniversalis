    description: "NAVI\u5728\u8D0F\u5F97EPL S14\u51A0\u8ECD\u5F8C\uFF0C\u6B63\u5F0F\u5B8C\u6210\u82F1\u7279\u723E\u5927\u6EFF\u8CAB\uFF0C\u6210\u70BA\u7E7CAstralis\u8207Team
      Liquid\u4E4B\u5F8C\u7B2C\u4E09\u652F\u9054\u6210\u6B64\u6210\u5C31\u7684\u968A\u4F0D\u3002\u4ED6\u5011\u5728\u5341\u7AD9\u8CFD\u4E8B\u9031\u671F\u4E2D\u596A\u4E0B\u56DB\u5EA7\u51A0\u8ECD\uFF0C\u5305\u62EC2020\u5E74IEM\u5361\u6258\u7DAD\u8332\u30012020\u5E74ESL
      One\u79D1\u9686\u6B50\u6D32\u5340\u30012021\u5E74IEM\u5361\u6258\u7DAD\u8332\u4EE5\u53CAEPL
      S14\u3002\u9019\u652F\u7368\u806F\u9AD4\u52C1\u65C5\u5728b1t\u6B63\u5F0F\u53D6\u4EE3flamie\u5F8C\uFF0C\u9663\u5BB9\u9054\u5230\u524D\u6240\u672A\u6709\u7684\u7A69\u5B9A\u8207\u9ED8\u5951\u3002s1mple\u7684\u500B\u4EBA\u7D71\u6CBB\u529B\u8207B1ad3\u7684\u6230\u8853\u9AD4\u7CFB\u5171\u540C\u9444\u9020\u4E86\u9019\u5EA7\u91CC\u7A0B\u7891\uFF0CNAVI\u7684\u6642\u4EE3\u5DF2\u7136\u964D\u81E8\u3002"
    firstPersonDescription: "\u6211\u5011\u5728\u8D0F\u5F97EPL S14\u51A0\u8ECD\u5F8C\uFF0C\u6B63\u5F0F\u5B8C\u6210\u4E86\u82F1\u7279\u723E\u5927\u6EFF\u8CAB\u7684\u58EF\u8209\uFF0C\u6210\u70BA\u7E7CAstralis\u8207Team
